{% if notes %}
<div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));">
  {% for note in notes %}
  <article>
    <header><strong>{{ note.title }}</strong></header>
    <p>{{ note.body }}</p>
    <footer>
      <button class="secondary outline"
              hx-post="/notes/{{ note.id }}/delete"
              hx-target="#notes-list" hx-swap="innerHTML"
              hx-confirm="¿Borrar esta nota?">Borrar</button>
    </footer>
  </article>
  {% endfor %}
</div>
{% else %}
<p><em>Aún no tienes notas. ¡Crea la primera arriba!</em></p>
{% endif %}
